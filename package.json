{
  "name": "nuxt-boilerplate",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:stage": "nuxt build --dotenv .env.stage",
    "build:prod": "nuxt build --dotenv .env.prod",
    "dev": "nuxt dev",
    "dev:stage": "nuxt dev --dotenv .env.stage",
    "dev:prod": "nuxt dev --dotenv .env.prod",
    "generate": "cross-env NUXT_USE_SSR=false nuxt generate",
    "generate:stage": "cross-env NUXT_USE_SSR=false nuxt generate --dotenv .env.stage",
    "generate:prod": "cross-env NUXT_USE_SSR=false nuxt generate --dotenv .env.prod",
    "sync:android": "npx cap sync android",
    "sync:android-stage": "cross-env NUXT_CAPACITOR_ENV=stage npx cap sync android",
    "sync:android-prod": "cross-env NUXT_CAPACITOR_ENV=prod npx cap sync android",
    "open:android": "npx cap open android",
    "sync:ios": "npx cap sync ios",
    "sync:ios-stage": "cross-env NUXT_CAPACITOR_ENV=stage npx cap sync ios",
    "sync:ios-prod": "cross-env NUXT_CAPACITOR_ENV=prod npx cap sync ios",
    "open:ios": "npx cap open ios",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"{components,pages,plugins,middleware,layouts,composables,assets,utils}/**/*.{js,jsx,ts,tsx,vue,html,css,scss,json,md}\"",
    "format:fix": "pnpm format --write",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@nuxt/fonts": "^0.7.2",
    "@nuxt/rspack-builder": "^3.12.2",
    "@pinia/nuxt": "^0.5.5",
    "eslint-plugin-tailwindcss": "^3.17.5",
    "nuxt": "^3.14.0",
    "nuxt-security": "2.0.0-rc.9",
    "nuxt-typed-router": "^3.7.0",
    "pinia": "^2.2.6",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@nuxt/eslint": "^0.3.13",
    "@nuxtjs/tailwindcss": "^6.12.2",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "daisyui": "^4.12.14",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vue-tsc": "^2.1.10"
  }
}
